# Company CA bundle path (source)
$companyCAPath = "C:\Path\To\CompanyCA\company-bundle.pem"

# Define client-specific paths
$clients = @(
    @{
        Name = "Azure"
        CACertPath = "C:\Program Files\Microsoft SDKs\Azure\CLI2\Lib\site-packages\certifi\cacert.pem"
    },
    @{
        Name = "Google"
        CACertPath = "$env:APPDATA\Google\Cloud SDK\google-cloud-sdk\platform\bundledpython\Lib\site-packages\pip\_vendor\certifi\cacert.pem"
    },
    @{
        Name = "AWS"
        CACertPath = "C:\Program Files\Amazon\AWSCLI\runtime\Lib\site-packages\pip\_vendor\certifi\cacert.pem"
    },
    @{
        Name = "GitBash"
        CACertPath = "C:\Program Files\Git\mingw64\ssl\certs\ca-bundle.crt"
    }
)

# Read the company CA bundle (including the three certificates)
$companyCACertificates = Get-Content -Path $companyCAPath

# Process each client
foreach ($client in $clients) {
    Write-Host "Processing $($client.Name) client"

    # Ensure target directory exists
    $targetDir = Split-Path -Path $client.CACertPath
    New-Item -ItemType Directory -Path $targetDir -Force | Out-Null

    # Append the company CA certificates to the client's existing certificate file
    $companyCACertificates | Add-Content -Path $client.CACertPath

    Write-Host "Appended company CA certificates to $($client.CACertPath)"
}

Write-Host "All clients processed successfully!"
