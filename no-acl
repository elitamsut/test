# =========================
# Provider
# =========================
provider "aws" {
  region = "il-central-1" # Israel region
}

# =========================
# Ubuntu 22.04 AMI
# =========================
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

# =========================
# Existing Network Resources
# =========================
data "aws_vpc" "existing" {
  id = "vpc-0452302a0853a2291"
}

data "aws_subnet" "subnet_a" {
  id = "subnet-03c0adfee408" # DHCP1
}

data "aws_subnet" "subnet_b" {
  id = "subnet-f9b" # DHCP2
}


# =========================
# Security Group
# (allows SSH + Kea Control API + DHCP inside VPC)
# =========================
resource "aws_security_group" "kea_sg" {
  vpc_id = data.aws_vpc.existing.id

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow SSH"
  }

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Kea Control Agent API"
  }

  ingress {
    from_port   = 67
    to_port     = 67
    protocol    = "udp"
    cidr_blocks = ["10.0.0.0/16"]
    description = "Allow DHCP requests inside VPC"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }

  tags = { Name = "kea-sg" }
}


# =========================
# Kea DHCP EC2 instances
# =========================
resource "aws_instance" "kea" {
  count         = 2
  ami           = data.aws_ami.ubuntu.id
  instance_type = "m5.large"
  subnet_id     = count.index == 0 ? data.aws_subnet.subnet_a.id : data.aws_subnet.subnet_b.id
  vpc_security_group_ids = [aws_security_group.kea_sg.id]

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
  }

  tags = {
    Name = count.index == 0 ? "kea-primary" : "kea-secondary"
  }
}
