trigger:
- main

pool:
  vmImage: 'ubuntu-latest'

jobs:
- job: UnzipAndUpload
  timeoutInMinutes: 120  # Set the timeout to 2 hours

  steps:
    # Step 1: Install Azure CLI (if it's not already installed)
    - script: |
        sudo apt-get update
        curl -sL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > microsoft.gpg
        sudo mv microsoft.gpg /etc/apt/trusted.gpg.d/microsoft.gpg
        sudo apt-get install -y software-properties-common
        sudo add-apt-repository -y https://packages.microsoft.com/repos/azure-cli/
        sudo apt-get update
        sudo apt-get install -y azure-cli
        az --version  # Verify installation
      displayName: 'Install Azure CLI'

    # Step 2: Execute Azure CLI Commands
    - task: AzureCLI@2
      inputs:
        azureSubscription: 'AzureRMConnection'
        scriptType: bash
        scriptLocation: inlineScript
        inlineScript: |
          # Variables for storage operations
          storageAccountName="zipstorageaccount"
          containerName="zipfiles"
          zipFilePath="wetransfer_word-files-pdf-html_2024-12-25_2044.zip"  # Blob name, e.g., 'file.zip'.
          unzipFolderPath="./unzipped-files"  # Local unzip folder.
          unzippedBlobFolder="unzipped"  # Blob folder where files will be uploaded.

          # Download the main zip file from Azure Blob Storage
          az storage blob download \
            --account-name $storageAccountName \
            --container-name $containerName \
            --name $zipFilePath \
            --file ./temp.zip --auth-mode login

          # Check if the download was successful
          if [ ! -f ./temp.zip ]; then
            echo "Failed to download zip file."
            exit 1
          fi

          # Create a folder for unzipped files and set permissions
          mkdir -p $unzipFolderPath
          chmod -R ugo+rw $unzipFolderPath  # Ensure read/write for all users

          # Unzip only the root-level files
          unzip -o ./temp.zip -d $unzipFolderPath || exit 1

          # List the extracted files (for debugging)
          echo "Unzipped files:"
          ls -l $unzipFolderPath

          # Iterate over each of the unzipped zip files (Html.zip, Source.zip, pdf.zip)
          for zipFile in $unzipFolderPath/*.zip; do
            # Extract each zip file's content into a new directory
            if [ -f "$zipFile" ]; then
              subFolder="$unzipFolderPath/$(basename "$zipFile" .zip)"
              mkdir -p "$subFolder"
              unzip -o "$zipFile" -d "$subFolder" || exit 1
            fi
          done

          # Upload the extracted files into separate subdirectories in Blob Storage
          for subDir in $unzipFolderPath/*/; do
            folderName=$(basename "$subDir")
            echo "Uploading content of $folderName to $unzippedBlobFolder/$folderName"
            az storage blob upload-batch \
              --account-name $storageAccountName \
              --destination "$containerName/$unzippedBlobFolder/$folderName" \
              --source "$subDir" \
              --auth-mode login \
              --overwrite true
          done

      displayName: 'Execute Azure CLI Commands for Unzipping and Uploading'
