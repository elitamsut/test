# Local .terraform directories
.terraform/

# .tfstate files and backups
*.tfstate
*.tfstate.*.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data like
# passwords, private keys, and other secrets.
#
# If you commonly use a specific name for your variable files (e.g.,
# 'terraform.tfvars'), you can add it here.
#
# Note: It is best practice to manage sensitive data using a secrets manager
# (like HashiCorp Vault) and not commit secrets to source control.
#
# example:
# terraform.tfvars
# *.auto.tfvars

# Ignore override files as they are usually used for local development
# overrides and should not be shared.
#
# example:
# override.tf
# override.tf.json
# *_override.tf
# *_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files
# *.dot

# Optional: ignore plan files saved with the -out flag
# tfplan*
