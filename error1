    # =========================
# Provider
# =========================
provider "aws" {
  region = "il-central-1" # Israel region
}

# =========================
# Ubuntu 24.04 AMI (Static)
# =========================
# Using the specified AWS Catalog AMI
data "aws_ami" "ubuntu" {
  owners = ["099720109477"] # Canonical
  filter {
    name   = "image-id"
    values = ["ami-07557ea5e9bef9923"]
  }
}

# =========================
# Existing Network Resources
# =========================
data "aws_vpc" "existing" {
  id = "vpc-0452302a0853a2291"
}

data "aws_subnet" "subnet_a" {
  id = "subnet-03c0adfe72e57e408" # DHCP1
}

data "aws_subnet" "subnet_b" {
  id = "subnet-0dfbf9b2cd1593ed6" # DHCP2
}
# =========================
# Kea DHCP EC2 Instances
# =========================
resource "aws_instance" "kea" {
  count         = 2
  ami           = data.aws_ami.ubuntu.id
  instance_type = "m5.large"

  # Assign subnet based on instance index
  subnet_id = count.index == 0 ? data.aws_subnet.subnet_a.id : data.aws_subnet.subnet_b.id

  # Use default security group or specify one
  vpc_security_group_ids = []

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
  }

  tags = {
    Name = count.index == 0 ? "kea-primary" : "kea-secondary"
    Role = "kea-dhcp"
  }
}

# =========================
# Outputs
# =========================
output "kea_instance_ids" {
  description = "IDs of the Kea DHCP EC2 instances"
  value       = aws_instance.kea[*].id
}

output "kea_instance_public_ips" {
  description = "Public IP addresses of the Kea DHCP EC2 instances"
  value       = aws_instance.kea[*].public_ip
}

output "kea_instance_private_ips" {
  description = "Private IP addresses of the Kea DHCP EC2 instances"
  value       = aws_instance.kea[*].private_ip
}
